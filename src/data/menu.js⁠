import React, { useState } from 'react';
import { menuData } from './data/menu';

export default function App() {
  const [activeCategory, setActiveCategory] = useState("All");
  const [cart, setCart] = useState([]);

  const filteredItems = activeCategory === "All" 
    ? menuData.items 
    : menuData.items.filter(item => item.category === activeCategory);

  const addToCart = (item) => {
    setCart([...cart, item]);
  };

  return (
    <div className="min-h-screen bg-neutral-900 text-amber-50 font-sans pb-24">
      {/* Header */}
      <header className="p-6 text-center border-b border-amber-500/20 bg-neutral-950 sticky top-0 z-10">
        <h1 className="text-3xl font-black tracking-wider text-amber-400 uppercase">
          Crescent City Flavor
        </h1>
        <p className="text-xs text-neutral-400 mt-1 tracking-widest uppercase">
          NOLA Street Eats & Artisanal Sweets
        </p>
      </header>

      {/* Category Pills */}
      <div className="flex gap-2 overflow-x-auto p-4 no-scrollbar border-b border-neutral-800">
        {menuData.categories.map((cat) => (
          <button
            key={cat}
            onClick={() => setActiveCategory(cat)}
            className={`px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
              activeCategory === cat
                ? "bg-amber-400 text-neutral-950"
                : "bg-neutral-800 text-neutral-300 hover:bg-neutral-700"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      {/* Menu List */}
      <main className="p-4 max-w-md mx-auto space-y-4">
        {filteredItems.map((item) => (
          <div key={item.id} className="flex bg-neutral-800/60 rounded-xl overflow-hidden border border-neutral-800">
            <img src={item.image} alt={item.name} className="w-28 h-28 object-cover" />
            <div className="p-3 flex-1 flex flex-col justify-between">
              <div>
                <div className="flex justify-between items-start">
                  <h3 className="font-bold text-sm text-amber-100">{item.name}</h3>
                  <span className="text-amber-400 font-bold text-sm">${item.price}</span>
                </div>
                <p className="text-neutral-400 text-xs mt-1 line-clamp-2">{item.description}</p>
              </div>
              <button
                onClick={() => addToCart(item)}
                className="mt-2 self-end px-3 py-1 bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs rounded-md transition-colors"
              >
                + Add
              </button>
            </div>
          </div>
        ))}
      </main>

      {/* Floating Order Bar */}
      {cart.length > 0 && (
        <div className="fixed bottom-4 left-4 right-4 max-w-md mx-auto bg-amber-400 text-neutral-950 p-4 rounded-xl flex justify-between items-center font-bold shadow-lg">
          <span>{cart.length} item(s) selected</span>
          <button className="bg-neutral-950 text-amber-400 px-4 py-2 rounded-lg text-xs font-black uppercase tracking-wider">
            View Order
          </button>
        </div>
      )}
    </div>
  );
}
